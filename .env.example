# FinCloud LMS — environment template (names and safe demo defaults only).
# Copy to .env.local for local development. Never commit real secrets.
# In staging/production set variables in the hosting platform, not in a file.

# --- Session signing -------------------------------------------------------
# Required in production. Minimum 32 characters. Generate with:
#   openssl rand -base64 48
# Leave unset in development to use the documented demo secret.
# FINCLOUD_SESSION_SECRET=

# --- Storage adapter -------------------------------------------------------
# development: leave unset (in-memory seed).
# production: must be set explicitly; the app refuses to start otherwise.
# FINCLOUD_STORE_ADAPTER=memory

# Staging/demo only. Acknowledges that data is ephemeral and isolated.
# Must be absent for any environment that carries real records.
# FINCLOUD_ALLOW_EPHEMERAL_STORE=true

# --- Node environment ------------------------------------------------------
# NODE_ENV=production
